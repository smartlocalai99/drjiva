{
  "expo": {
    "name": "DrJiva",
    "slug": "drjiva-app",
    "scheme": "drjiva",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drjiva.patient",
      "appleTeamId": "BX5AUC6729",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow DrJiva to take your profile photo.",
        "NSPhotoLibraryUsageDescription": "Allow DrJiva to choose your profile photo."
      }
    },
    "android": {
      "package": "com.drjiva.patient",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/logo.png",
          "imageWidth": 116,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DrJiva to choose your profile photo.",
          "cameraPermission": "Allow DrJiva to take your profile photo.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "medicine-reminders"
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Allow DrJiva to scan medical reports."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow DrJiva to use your current location to fill in your delivery address."
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b14ceb65-2bb3-4da7-840b-13559e5ee03f"
      }
    },
    "owner": "vardhanreddy",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b14ceb65-2bb3-4da7-840b-13559e5ee03f"
    }
  }
}
